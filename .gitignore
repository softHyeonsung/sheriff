# 산책냥 — 리포 루트 .gitignore
# mobile/(Expo), supabase/(CLI) 각각 자체 .gitignore도 생성되지만,
# 여기서는 리포 전체에 적용될 패턴(보안·OS·에디터·빌드산출물)을 관리한다.

# --- OS ---
.DS_Store
Thumbs.db
Desktop.ini

# --- 에디터/IDE ---
.vscode/
.idea/
*.swp

# --- 시크릿/인증정보 (절대 커밋 금지) ---
.env
.env.local
.env.*.local
*.pem
*.key
*.p12
*.jks
*.keystore
*.mobileprovision
google-services.json
GoogleService-Info.plist
credentials.json
**/service-account*.json
**/*-credentials.json
supabase/.env

# --- Node ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Expo / React Native (managed workflow — 네이티브 폴더 커밋 안 함) ---
.expo/
.expo-shared/
dist/
web-build/
android/
ios/
*.orig.*

# --- EAS ---
.eas/

# --- Supabase 로컬 개발 산출물 ---
supabase/.branches/
supabase/.temp/

# --- 테스트/커버리지/로그 ---
coverage/
*.log

# --- 이 세션의 임시 작업공간 (SDD 플랜 진행 스크래치, 커밋 대상 아님) ---
.superpowers/
supabase/.admin_dongs.sql
mobile/scripts/cats-preview.png
mobile/scripts/cats-preview/
mobile/scripts/__pycache__/
